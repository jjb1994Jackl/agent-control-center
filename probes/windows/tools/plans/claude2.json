{
  "waitSeconds": 12,
  "guard": {
    "engine": "claude"
  },
  "steps": [
    {
      "label": "claude 1 open from behind: ExpandCollapse.Expand",
      "engine": "claude",
      "args": [
        "--locator",
        "modelMenu",
        "--do",
        "expand"
      ],
      "pauseMs": 1500
    },
    {
      "label": "claude 2 submenu: Expand on Effort",
      "engine": "claude",
      "args": [
        "--role",
        "AXMenuItem",
        "--prefix",
        "Effort",
        "--do",
        "expand"
      ],
      "pauseMs": 1200
    },
    {
      "label": "claude 3 read: the High row",
      "engine": "claude",
      "args": [
        "--role",
        "AXMenuItem",
        "--prefix",
        "High",
        "--do",
        "inspect",
        "--names"
      ]
    },
    {
      "label": "claude 4 pick the current effort: Invoke on High",
      "engine": "claude",
      "args": [
        "--role",
        "AXMenuItem",
        "--prefix",
        "High",
        "--do",
        "invoke"
      ],
      "pauseMs": 1500
    },
    {
      "label": "claude 5 read: the model button after the pick",
      "engine": "claude",
      "args": [
        "--locator",
        "modelMenu",
        "--do",
        "inspect",
        "--names"
      ]
    },
    {
      "label": "claude 6 open again and Expand on More models",
      "engine": "claude",
      "args": [
        "--locator",
        "modelMenu",
        "--do",
        "expand"
      ],
      "pauseMs": 1500
    },
    {
      "label": "claude 7 submenu: Expand on More models",
      "engine": "claude",
      "args": [
        "--role",
        "AXMenuItem",
        "--prefix",
        "More models",
        "--do",
        "expand"
      ],
      "pauseMs": 1200
    },
    {
      "label": "claude 8 pick the current model: SelectionItem.Select on Opus 5.5",
      "engine": "claude",
      "args": [
        "--role",
        "AXMenuItem",
        "--prefix",
        "Opus 5.5",
        "--do",
        "select"
      ],
      "pauseMs": 1500
    },
    {
      "label": "claude 9 read: the model button after the select",
      "engine": "claude",
      "args": [
        "--locator",
        "modelMenu",
        "--do",
        "inspect",
        "--names"
      ]
    },
    {
      "label": "claude 10 fill the composer: Value.SetValue",
      "engine": "claude",
      "args": [
        "--locator",
        "composer",
        "--do",
        "setvalue",
        "--text",
        "Frontdesk Windows 测试：请只回复 OK，不要运行任何命令。",
        "--watch",
        "send"
      ],
      "pauseMs": 1200
    },
    {
      "label": "claude 11 send: Invoke on Send",
      "engine": "claude",
      "args": [
        "--locator",
        "send",
        "--do",
        "invoke"
      ],
      "pauseMs": 3000
    }
  ]
}
