{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/client/**/*", "src/shared/**/*"],
  "exclude": ["src/client/public/**"]
}
